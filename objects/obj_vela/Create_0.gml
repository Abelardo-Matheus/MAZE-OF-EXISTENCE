// feather disable GM2017
// Antes: 32x50 calculado do sprite 89x168. Sprite refeito em 64x64 usa o fator de ajuste.
image_xscale = (32 / 89) * sprite_ajuste(sprite_index);
image_yscale = (50 / 168) * sprite_ajuste(sprite_index);

global.vela_coletada = false;
global.brilho_vela_surface = surface_create(room_width, room_height);

























